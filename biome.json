{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!drizzle",
      "!.omc"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/application/*",
                  "@/server/modules/*/application/**",
                  "@/server/modules/*/domain/*",
                  "@/server/modules/*/domain/**",
                  "@/server/modules/*/infra/*",
                  "@/server/modules/*/infra/**",
                  "@/server/modules/*/interfaces/*",
                  "@/server/modules/*/interfaces/**"
                ],
                "message": "Import the module public API (@/modules/<name> or @/server/modules/<name>), not internals. UI lives in src/components."
              }
            ]
          }
        }
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
